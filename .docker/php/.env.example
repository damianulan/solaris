APP_NAME="Solaris"
APP_ENV=local
APP_LOCALE=pl
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:37002
APP_TIMEZONE='Europe/Warsaw'

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=solaris
DB_USERNAME=solaris
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=300
SESSION_DOMAIN=
SESSION_ENCRYPTION=false
SESSION_SECURE_COOKIE=false
ACTIVITY_LOGGER_ENABLED=true
DEBUGBAR_ENABLED=true

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@solaris.test"
MAIL_HOST_ADDRESS="no-reply@solaris.test"
MAIL_FROM_NAME="${APP_NAME}"
MAILCATCHALL_ENABLED=true
MAILCATCHALL_RECEIVER="dev@solaris.test"

SETTINGS_CACHE_ENABLED=true

DATEFORMAT="d.m.Y"
TIMEFORMAT="H:i"

REDIS_HOST=redis
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
