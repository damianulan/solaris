{
    "name": "damianulan/solaris",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "akaunting/laravel-apexcharts": "^4.0",
        "damianulan/laravel-modularis": "dev-main",
        "damianulan/laravel-sentinel": "dev-main",
        "fakerphp/faker": "^1.23",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.24",
        "laravel/prompts": "*",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^v5.6.3",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^3.1",
        "maennchen/zipstream-php": "*",
        "opcodesio/log-viewer": " *",
        "phpoffice/phpspreadsheet": "^1.27",
        "phpoffice/phpword": "^1.4.0",
        "predis/predis": "^v3.4.2",
        "rahulhaque/laravel-filepond": "^v13",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-settings": "^3.1",
        "spatie/laravel-tags": "^4.10",
        "spatie/laravel-translatable": "^6.11",
        "tightenco/ziggy": "^v2.3",
        "tjvb/laravel-mail-catchall": "^4.4",
        "vlucas/phpdotenv": "^5.6",
        "wikimedia/composer-merge-plugin": "*",
        "ymigval/laravel-model-cache": "^1.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.1",
        "fruitcake/laravel-debugbar": "^4.4",
        "laravel/boost": "^2.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "*",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpunit/phpunit": "*",
        "spatie/boost-spatie-guidelines": "^1.1",
        "spatie/laravel-ignition": "^2.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json",
                "modules/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-replace": true,
            "merge-scripts": false
        },
        "laravel": {
            "dont-discover": [
                "modules/enterprise"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
